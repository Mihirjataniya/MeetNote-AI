PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/meetnote

# JWT
JWT_SECRET=change-me-to-a-random-secret

# MediaSoup
RTC_MIN_PORT=40000
RTC_MAX_PORT=49999
MEDIASOUP_LISTEN_IP=0.0.0.0


#  the server binds to a private IP (10.x.x.x) but clients need to reach the public IP. You'd set this to the server's public IP (e.g., MEDIASOUP_ANNOUNCED_IP=203.0.113.50).

MEDIASOUP_ANNOUNCED_IP=

