PORT=3000
NODE_ENV=development

# Public URL of the client app (used for links). Prod: your frontend origin.
APP_URL=http://localhost:5173

# CORS allow-list for the HTTP API + socket.io. "*" is fine for local dev;
# in prod set to your frontend origin (e.g. https://app.example.com).
CORS_ORIGIN=*

# MongoDB
MONGODB_URI=mongodb://localhost:27017/meetnote

# JWT
JWT_SECRET=change-me-to-a-random-secret
# Token lifetime (e.g. 7d, 24h, 3600). Defaults to 7d.
JWT_EXPIRES_IN=7d

# MediaSoup
RTC_MIN_PORT=40000
RTC_MAX_PORT=49999
MEDIASOUP_LISTEN_IP=0.0.0.0


#  the server binds to a private IP (10.x.x.x) but clients need to reach the public IP. You'd set this to the server's public IP (e.g., MEDIASOUP_ANNOUNCED_IP=203.0.113.50).

MEDIASOUP_ANNOUNCED_IP=

# Deepgram (transcription)
DEEPGRAM_API_KEY=

# Cloudinary (audio storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS SQS (transcription + notes job queue)
AWS_REGION=us-east-1
# Real AWS: set credentials (or use an IAM role / shared config and leave blank).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local dev: point at an SQS emulator and use any dummy creds above.
#   ElasticMQ:  SQS_ENDPOINT=http://localhost:9324
#   LocalStack: SQS_ENDPOINT=http://localhost:4566
SQS_ENDPOINT=
# Physical queue names are <prefix>-transcribe-batch, <prefix>-finalize-pipeline, <prefix>-generate-notes (+ -dlq).
SQS_QUEUE_PREFIX=meetnote
# Run the consumer loops in this process. Set false for a web-only process.
SQS_WORKER_ENABLED=true
# Deliveries before a message is dead-lettered.
SQS_MAX_RECEIVE_COUNT=5
